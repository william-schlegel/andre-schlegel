---
import Base from '../layouts/Base.astro';
import Journey from '../journey/Journey';
---

<Base
  title="Commandant André Schlegel — carrière militaire et aéronautique, 1935-1962"
  description="Le parcours du commandant André Schlegel, navigateur de bombardier, de Tours à Elvington et au-delà, raconté par son petit-fils Éric Lemoine à partir de ses carnets de vol."
>
  <main>
    <Journey client:only="react" />
    <noscript>
      <div style="padding:2rem;max-width:40rem;margin:auto;font-size:1.2rem">
        <h1>Commandant André Schlegel</h1>
        <p>Ce parcours raconté et animé a besoin de JavaScript. Les sources et le film d’origine sont présentés sur la page <a href="/sources" style="color:inherit">Sources</a>.</p>
      </div>
    </noscript>
  </main>
</Base>
