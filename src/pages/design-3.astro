---
import ContentShowcase from '../components/ContentShowcase.astro';
import { loadPresentationContents } from '../lib/content-presentations';

const events = await loadPresentationContents();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design 3 | Memorial cartographique moderne</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unna:wght@400;700&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #f0eee6;
        --surface: #f8f5ed;
        --ink: #1f2b34;
        --muted: #5a6770;
        --accent: #9a6a3e;
        --accent-2: #2f5564;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Manrope', sans-serif;
        color: var(--ink);
        background: linear-gradient(150deg, #e9e7df 0%, #f6f3ea 45%, #ebe6db 100%);
      }
      .mesh {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 10% 20%, rgba(47,85,100,.12), transparent 30%),
          radial-gradient(circle at 90% 30%, rgba(154,106,62,.18), transparent 32%),
          radial-gradient(circle at 30% 90%, rgba(47,85,100,.1), transparent 35%);
      }
      .shell { width: min(1180px, 93vw); margin: 0 auto; position: relative; }
      h1, h2, h3 { font-family: 'Unna', serif; margin: 0; }
      h1 { font-size: clamp(2rem, 5.3vw, 4.2rem); }
      .hero {
        min-height: 96vh;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 0;
      }
      .hero img {
        width: 100%;
        border-radius: 22px;
        border: 1px solid rgba(31,43,52,.2);
        box-shadow: 0 16px 45px rgba(31,43,52,.2);
        animation: panelIn .95s cubic-bezier(.22,1,.36,1) both;
      }
      .kicker {
        text-transform: uppercase;
        letter-spacing: .2em;
        font-size: .75rem;
        color: var(--accent-2);
      }
      .section { padding: 1rem 0 2.4rem; }
      .section-showcase {
        padding: 0;
      }
      .years {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
      }
      .year {
        background: var(--surface);
        border-radius: 14px;
        border: 1px solid rgba(31,43,52,.16);
        padding: 1rem;
        transition: transform .3s ease, box-shadow .3s ease;
      }
      .year:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(31,43,52,.14);
      }
      footer { text-align: center; padding: 2rem 0; color: var(--muted); }
      @keyframes panelIn { from { opacity: 0; transform: translateY(20px) scale(.98);} to { opacity: 1; transform: none; } }
      @media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; min-height: auto; }
      }
    </style>
  </head>
  <body>
    <div class="mesh"></div>
    <main class="shell">
      <section class="hero">
        <div>
          <p class="kicker">Design 3 · Memorial cartographique moderne</p>
          <h1>Trajectoires, territoires, memoire</h1>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras non tincidunt urna. Integer at nisl ac nisl varius vestibulum non id risus.</p>
        </div>
        <img src="https://picsum.photos/900/1200?grayscale&random=13" alt="Portrait memorial placeholder" loading="lazy" />
      </section>

      <section class="section section-showcase">
        <ContentShowcase items={events} variant="design3" />
      </section>

      <section class="section">
        <h2>Chronologie annuelle</h2>
        <div class="years">
          {events.map((event) => (
            <article class="year">
              <h3>{event.date.slice(0, 4)}</h3>
              <p>{event.date} · {event.title}</p>
            </article>
          ))}
        </div>
      </section>

      <footer>2026 · Site de memoire · <a href="/">Comparer les designs</a></footer>
    </main>
  </body>
</html>
