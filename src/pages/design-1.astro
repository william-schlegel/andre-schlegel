---
import ContentShowcase from '../components/ContentShowcase.astro';
import { loadPresentationContents } from '../lib/content-presentations';

const events = await loadPresentationContents();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design 1 | Archives cinematographiques</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #131615;
        --panel: #1b201d;
        --ink: #ece6d5;
        --muted: #a6a18f;
        --accent: #8d9e58;
        --line: #2e352f;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        color: var(--ink);
        font-family: 'Source Sans 3', sans-serif;
        background: radial-gradient(circle at 20% 20%, #222b25, var(--bg) 45%), var(--bg);
        min-height: 100vh;
      }
      .grain::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
        background-size: 3px 3px;
        pointer-events: none;
        opacity: 0.16;
      }
      header {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 2rem;
        align-items: center;
        padding: clamp(1rem, 3vw, 3rem);
      }
      h1, h2 { font-family: 'Cinzel', serif; letter-spacing: 0.04em; margin: 0; }
      h1 { font-size: clamp(2rem, 5vw, 4rem); line-height: 1.1; }
      p { line-height: 1.7; }
      .hero-media img {
        width: 100%;
        border-radius: 1rem;
        border: 1px solid var(--line);
        box-shadow: 0 20px 35px rgba(0,0,0,0.45);
        animation: floatIn 1.1s ease both;
      }
      .hero-copy { animation: reveal 1s ease .15s both; }
      .tag { color: var(--accent); text-transform: uppercase; letter-spacing: .2em; font-size: .8rem; }
      .section {
        padding: clamp(1rem, 4vw, 4rem);
      }
      .section-showcase {
        padding: 0;
      }
      .recap-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }
      .recap {
        padding: 1rem;
        background: rgba(17, 22, 19, 0.8);
        border: 1px solid var(--line);
        border-radius: 12px;
      }
      footer { padding: 2rem; text-align: center; color: var(--muted); }
      a { color: var(--ink); }
      @keyframes reveal { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
      @keyframes floatIn { from { opacity: 0; transform: translateY(20px) scale(.98); } to { opacity: 1; transform: none; } }
      @media (max-width: 900px) {
        header { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body class="grain">
    <header>
      <div class="hero-copy">
        <p class="tag">Design 1 · Archives cinematographiques</p>
        <h1>Andre Schlegel,<br />memoire de guerre</h1>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur convallis nibh at nulla interdum, ac luctus leo volutpat.</p>
      </div>
      <div class="hero-media">
        <img src="https://picsum.photos/900/1200?grayscale&random=11" alt="Portrait historique placeholder" loading="lazy" />
      </div>
    </header>

    <section class="section section-showcase">
      <ContentShowcase items={events} variant="design1" />
    </section>

    <section class="section">
      <h2>Recapitulatif par annee</h2>
      <div class="recap-grid">
        {events.map((event) => (
          <article class="recap">
            <h3>{event.date.slice(0, 4)}</h3>
            <p>{event.date} · {event.title}</p>
          </article>
        ))}
      </div>
    </section>

    <footer>
      2026 · Site memorial · <a href="/">Comparer les designs</a>
    </footer>
  </body>
</html>
