---
import ContentShowcaseClient from './ContentShowcaseClient';
import type { PresentationContent } from '../lib/presentation-types';

type Props = {
  items: PresentationContent[];
  variant: 'design1' | 'design2' | 'design3';
};

const { items, variant } = Astro.props as Props;
---

<ContentShowcaseClient client:load items={items} variant={variant} />

<style is:global>
@import "maplibre-gl/dist/maplibre-gl.css";

.content-showcase {
  min-height: calc(var(--step-count, 12) * 35vh);
  position: relative;
}

.showcase-sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  padding: clamp(1rem, 2vw, 2rem);
  display: flex;
  align-items: stretch;
}

.showcase-shell {
  width: 100%;
  min-height: calc(100vh - 2rem);
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: clamp(1rem, 2vw, 2rem);
}

.showcase-progress {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.5rem;
  position: relative;
}

.progress-kicker {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin: 0;
  font-size: 0.76rem;
  opacity: 0.8;
}

.progress-title,
.progress-step {
  margin: 0;
  font-size: 0.88rem;
  line-height: 1.35;
}

.progress-meter {
  width: 8px;
  height: min(46vh, 320px);
  background: var(--progress-track);
  border-radius: 999px;
  position: relative;
  overflow: hidden;
}

.progress-meter span {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, var(--progress-accent-soft), var(--progress-accent));
  border-radius: inherit;
}

.progress-range {
  width: min(45vh, 320px);
  transform: rotate(-90deg);
  transform-origin: 50% 50%;
  margin: 5.5rem 0;
  accent-color: var(--progress-accent);
}

.showcase-stage {
  border: 1px solid var(--stage-border);
  background: var(--stage-bg);
  border-radius: 16px;
  padding: clamp(1rem, 2.3vw, 2rem);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  overflow: hidden;
}

.stage-card {
  border-radius: 14px;
  border: 1px solid var(--stage-inner-border);
  background: var(--stage-inner-bg);
  padding: clamp(1rem, 1.6vw, 1.5rem);
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.stage-card h3,
.stage-card p {
  margin: 0;
}

.stage-meta h2 {
  margin: 0;
  font-size: clamp(1.55rem, 3vw, 2.3rem);
}

.stage-card .lead {
  max-width: 76ch;
  line-height: 1.6;
}

.stage-columns {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.stage-map,
.stage-gallery {
  min-height: 460px;
}

.map-canvas {
  height: clamp(240px, 52vh, 460px);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--stage-inner-border);
}

.map-placeholder {
  display: grid;
  place-items: center;
  opacity: 0.7;
  font-size: 0.9rem;
}

.timeline-card {
  margin-top: 0.35rem;
}

.timeline-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0.38rem;
}

.timeline-list li {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.35rem 0.55rem;
  border-radius: 8px;
  border: 1px dashed var(--stage-inner-border);
  opacity: 0.52;
}

.timeline-list li.is-active {
  opacity: 1;
  border-style: solid;
  background: color-mix(in oklab, var(--stage-inner-bg) 78%, var(--progress-accent) 22%);
}

.timeline-list li span {
  font-variant-numeric: tabular-nums;
  font-size: 0.8rem;
  min-width: 4.3rem;
}

.timeline-list li strong {
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 0.75rem;
}

.timeline-list li em {
  font-style: normal;
  font-size: 0.78rem;
  opacity: 0.85;
}

.route-legend {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0.4rem;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.route-legend li {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-size: 0.9rem;
}

.route-legend li span {
  display: inline-flex;
  width: 1.8rem;
  height: 1.8rem;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  background: var(--stage-chip-bg);
  color: var(--stage-chip-ink);
  font-size: 0.78rem;
}

.thumb-grid {
  display: grid;
  gap: 0.7rem;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  margin: 0;
  padding: 0;
  list-style: none;
}

.thumb-grid button {
  border: 0;
  padding: 0;
  background: transparent;
  cursor: pointer;
  width: 100%;
}

.thumb-grid img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
  border: 1px solid var(--stage-inner-border);
  min-height: 128px;
}

.media-modal {
  position: fixed;
  inset: 0;
  z-index: 140;
  background: rgba(0, 0, 0, 0.62);
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  padding: 1rem;
}

.media-modal-inner {
  width: min(900px, 95vw);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.28);
  background: #0f1418;
}

.media-modal-inner button {
  border: 0;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  padding: 0.6rem 1rem;
  cursor: pointer;
}

.media-modal-inner img {
  display: block;
  width: 100%;
}

.plane-marker {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(7, 10, 18, 0.9);
  color: #fff;
  font-size: 0.9rem;
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.hero-image-overlay {
  position: fixed;
  top: 8vh;
  z-index: 130;
  width: min(36vw, 520px);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 24px 55px rgba(0, 0, 0, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.hero-image-overlay img {
  display: block;
  width: 100%;
}

.hero-image-overlay.hero-left {
  left: 3vw;
}

.hero-image-overlay.hero-right {
  right: 3vw;
}

.content-showcase.design1 {
  --stage-bg: rgba(20, 25, 22, 0.92);
  --stage-border: #2e352f;
  --stage-inner-bg: rgba(15, 19, 17, 0.88);
  --stage-inner-border: #37413b;
  --stage-chip-bg: rgba(141, 158, 88, 0.18);
  --stage-chip-ink: #dfe8c4;
  --progress-track: #283127;
  --progress-accent: #8d9e58;
  --progress-accent-soft: #b6c98a;
  --route-color: #bdd277;
  --route-point-color: #edf6cd;
}

.content-showcase.design2 {
  --stage-bg: rgba(235, 222, 192, 0.84);
  --stage-border: #9e8b66;
  --stage-inner-bg: rgba(226, 211, 176, 0.68);
  --stage-inner-border: #98845f;
  --stage-chip-bg: rgba(138, 27, 19, 0.16);
  --stage-chip-ink: #611810;
  --progress-track: #b9a57f;
  --progress-accent: #8a1b13;
  --progress-accent-soft: #b54840;
  --route-color: #8a1b13;
  --route-point-color: #4f120e;
}

.content-showcase.design3 {
  --stage-bg: rgba(247, 243, 235, 0.74);
  --stage-border: rgba(31, 43, 52, 0.2);
  --stage-inner-bg: rgba(250, 246, 239, 0.94);
  --stage-inner-border: rgba(47, 85, 100, 0.3);
  --stage-chip-bg: rgba(47, 85, 100, 0.16);
  --stage-chip-ink: #274654;
  --progress-track: rgba(47, 85, 100, 0.2);
  --progress-accent: #2f5564;
  --progress-accent-soft: #6a8b9a;
  --route-color: #2f5564;
  --route-point-color: #9a6a3e;
}

@media (max-width: 960px) {
  .showcase-sticky {
    height: 100dvh;
    padding: 1rem;
  }

  .showcase-shell {
    min-height: auto;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .showcase-progress {
    order: 2;
  }

  .progress-meter {
    width: 100%;
    height: 8px;
  }

  .progress-meter span {
    height: 100% !important;
    right: auto;
  }

  .progress-range {
    width: 100%;
    transform: none;
    margin: 0;
  }

  .stage-columns {
    grid-template-columns: 1fr;
  }

  .stage-map,
  .stage-gallery {
    min-height: 320px;
  }

  .map-canvas {
    height: 260px;
  }

  .hero-image-overlay {
    width: min(82vw, 440px);
    top: 10vh;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
  }
}
</style>
