[
 {
  "start": 1783.5,
  "end": 1784.95,
  "text": "La vidéo qui va suivre"
 },
 {
  "start": 1785.7,
  "end": 1788.36,
  "text": "va vous montrer le déroulement d’une mission de nuit sur l’Allemagne,"
 },
 {
  "start": 1789.14,
  "end": 1791.13,
  "text": "du briefing à l’atterrissage."
 },
 {
  "start": 1791.69,
  "end": 1795.2,
  "text": "Elle a été recréée à partir de documents photos et vidéos de la base d’Elvington,"
 },
 {
  "start": 1795.3,
  "end": 1799.42,
  "text": "en particulier un film d’instruction du Squadron 347 « Tunisie »."
 },
 {
  "start": 1800.2,
  "end": 1802.3,
  "text": "On y voit un avion que notre grand-père a piloté,"
 },
 {
  "start": 1802.56,
  "end": 1804.31,
  "text": "comme celui sur le diorama."
 },
 {
  "start": 1804.79,
  "end": 1808.79,
  "text": "La vidéo en couleur est la seule montrant des Halifax Mk II pilotés par des Canadiens."
 },
 {
  "start": 1812.56,
  "end": 1816.82,
  "text": "Mission de nuit sur l’Allemagne à bord d’un bombardier Halifax."
 },
 {
  "start": 1818.56,
  "end": 1820.42,
  "text": "Le briefing des équipages."
 },
 {
  "start": 1821.68,
  "end": 1823.48,
  "text": "D’abord, les navigateurs,"
 },
 {
  "start": 1825.12,
  "end": 1826.66,
  "text": "puis associés aux pilotes,"
 },
 {
  "start": 1827.98,
  "end": 1832.22,
  "text": "et enfin avec la totalité des membres d’équipage."
 },
 {
  "start": 1834.48,
  "end": 1840.48,
  "text": "On leur précise l’objectif, les trajets, les points chauds, la Flak et les chasseurs."
 },
 {
  "start": 1842.0,
  "end": 1845.42,
  "text": "Pendant ce temps, les équipes au sol ravitaillent les avions :"
 },
 {
  "start": 1846.76,
  "end": 1851.8,
  "text": "carburant, bombes, oxygène, etc."
 },
 {
  "start": 1853.68,
  "end": 1856.0,
  "text": "Puis c’est l’embarquement des équipages :"
 },
 {
  "start": 1858.86,
  "end": 1860.14,
  "text": "par la trappe arrière"
 },
 {
  "start": 1861.36,
  "end": 1862.3,
  "text": "— attention à la tête ! —"
 },
 {
  "start": 1863.04,
  "end": 1865.5,
  "text": "et par la trappe avant."
 },
 {
  "start": 1869.9,
  "end": 1870.72,
  "text": "Tout est prêt."
 },
 {
  "start": 1872.08,
  "end": 1873.3,
  "text": "Après la check-list,"
 },
 {
  "start": 1874.08,
  "end": 1876.3,
  "text": "démarrage des moteurs, toujours dans le même ordre."
 },
 {
  "start": 1877.22,
  "end": 1879.66,
  "text": "D’abord l’extérieur gauche,"
 },
 {
  "start": 1892.86,
  "end": 1894.9,
  "text": "puis l’intérieur gauche,"
 },
 {
  "start": 1906.2,
  "end": 1909.66,
  "text": "bien sûr l’intérieur droit,"
 },
 {
  "start": 1915.24,
  "end": 1920.06,
  "text": "et enfin l’extérieur droit."
 },
 {
  "start": 1928.2,
  "end": 1929.3,
  "text": "Les quatre moteurs tournent."
 },
 {
  "start": 1930.6,
  "end": 1931.2,
  "text": "C’est bon !"
 },
 {
  "start": 1932.28,
  "end": 1933.2,
  "text": "On peut enlever les cales"
 },
 {
  "start": 1933.56,
  "end": 1935.72,
  "text": "et commencer à rouler des aires de dispersion"
 },
 {
  "start": 1936.56,
  "end": 1938.14,
  "text": "vers la piste de décollage."
 },
 {
  "start": 1944.66,
  "end": 1945.94,
  "text": "Pendant le roulage,"
 },
 {
  "start": 1946.34,
  "end": 1948.04,
  "text": "check-list de l’équipage :"
 },
 {
  "start": 1950.54,
  "end": 1952.04,
  "text": "Pilote."
 },
 {
  "start": 1952.96,
  "end": 1953.8,
  "text": "Navigateur."
 },
 {
  "start": 1957.24,
  "end": 1957.9,
  "text": "Bombardier."
 },
 {
  "start": 1961.32,
  "end": 1962.92,
  "text": "Mécanicien de vol."
 },
 {
  "start": 1964.84,
  "end": 1965.7,
  "text": "Opérateur radio."
 },
 {
  "start": 1969.08,
  "end": 1970.0,
  "text": "Mitrailleur supérieur."
 },
 {
  "start": 1972.6,
  "end": 1974.8,
  "text": "Et enfin, mitrailleur de queue."
 },
 {
  "start": 1975.4,
  "end": 1977.4,
  "text": "Tout le monde est prêt à décoller."
 },
 {
  "start": 1981.8,
  "end": 1984.4,
  "text": "La tour, avec l’officier commandant le squadron,"
 },
 {
  "start": 1984.76,
  "end": 1987.2,
  "text": "donne l’autorisation de décollage, avec la direction du vent"
 },
 {
  "start": 1988.14,
  "end": 1989.42,
  "text": "et les dernières instructions."
 },
 {
  "start": 1991.74,
  "end": 1995.48,
  "text": "L’un derrière l’autre, les avions se dirigent vers le seuil de la piste."
 },
 {
  "start": 2004.58,
  "end": 2005.84,
  "text": "Un dernier virage"
 },
 {
  "start": 2006.6,
  "end": 2008.5,
  "text": "avant le point fixe."
 },
 {
  "start": 2023.52,
  "end": 2026.66,
  "text": "Au signal, et à l’heure précise : décollage !"
 },
 {
  "start": 2027.4,
  "end": 2028.5,
  "text": "Moteurs à fond…"
 },
 {
  "start": 2030.6,
  "end": 2032.6,
  "text": "et c’est parti !"
 },
 {
  "start": 2035.3,
  "end": 2038.9,
  "text": "Lourdement chargé de bombes et de carburant,"
 },
 {
  "start": 2039.64,
  "end": 2043.82,
  "text": "le quadrimoteur s’élève péniblement vers le ciel."
 },
 {
  "start": 2049.2,
  "end": 2053.18,
  "text": "Train et volets rentrés."
 },
 {
  "start": 2056.08,
  "end": 2058.96,
  "text": "Passage bas"
 },
 {
  "start": 2064.52,
  "end": 2067.34,
  "text": "avant de prendre de l’altitude."
 },
 {
  "start": 2069.62,
  "end": 2074.68,
  "text": "Puis c’est le regroupement par squadron,"
 },
 {
  "start": 2078.04,
  "end": 2081.0,
  "text": "suivi de longues heures de transit au-dessus de la mer,"
 },
 {
  "start": 2086.26,
  "end": 2089.46,
  "text": "vers l’Allemagne, vers l’objectif,"
 },
 {
  "start": 2091.66,
  "end": 2093.22,
  "text": "guidés par le navigateur,"
 },
 {
  "start": 2099.58,
  "end": 2101.32,
  "text": "puis le bombardier,"
 },
 {
  "start": 2102.6,
  "end": 2104.06,
  "text": "en finale sur l’objectif."
 },
 {
  "start": 2109.2,
  "end": 2112.12,
  "text": "Enfin, la cible est là, en dessous, et…"
 },
 {
  "start": 2113.3,
  "end": 2115.78,
  "text": "« Bombes larguées ! »"
 },
 {
  "start": 2117.46,
  "end": 2118.64,
  "text": "C’est la délivrance."
 },
 {
  "start": 2121.08,
  "end": 2122.86,
  "text": "Cependant, il faut maintenir la trajectoire"
 },
 {
  "start": 2123.2,
  "end": 2124.8,
  "text": "vingt longues et angoissantes secondes,"
 },
 {
  "start": 2125.78,
  "end": 2128.44,
  "text": "pour la nécessaire photo de validation du raid."
 },
 {
  "start": 2132.32,
  "end": 2135.9,
  "text": "Il faut aussi éviter de toucher des camarades volant en dessous."
 },
 {
  "start": 2136.48,
  "end": 2138.26,
  "text": "Cela arrive parfois, tellement ils sont nombreux :"
 },
 {
  "start": 2139.1,
  "end": 2140.2,
  "text": "jusqu’à mille avions."
 },
 {
  "start": 2141.26,
  "end": 2142.6,
  "text": "Notez les marqueurs incendiaires"
 },
 {
  "start": 2143.16,
  "end": 2145.06,
  "text": "largués par les fameux « Pathfinders »,"
 },
 {
  "start": 2145.54,
  "end": 2146.86,
  "text": "arrivés les premiers sur place."
 },
 {
  "start": 2153.48,
  "end": 2154.42,
  "text": "Pendant ce temps,"
 },
 {
  "start": 2155.7,
  "end": 2157.84,
  "text": "les nazis, prévenus par les radars"
 },
 {
  "start": 2159.3,
  "end": 2161.48,
  "text": "et en dépit du brouillage, envoient la chasse de nuit,"
 },
 {
  "start": 2170.46,
  "end": 2173.34,
  "text": "ainsi que la Flak antiaérienne, au milieu des projecteurs,"
 },
 {
  "start": 2174.38,
  "end": 2176.84,
  "text": "des traceuses et des explosions."
 },
 {
  "start": 2187.46,
  "end": 2192.5,
  "text": "Beaucoup d’équipages ne reviendront pas de cet enfer de feu et de nuit."
 },
 {
  "start": 2199.98,
  "end": 2203.02,
  "text": "Un sur deux périrent…"
 },
 {
  "start": 2206.94,
  "end": 2210.78,
  "text": "comme cet Halifax,"
 },
 {
  "start": 2215.44,
  "end": 2218.4,
  "text": "quatre moteurs en feu."
 },
 {
  "start": 2225.34,
  "end": 2228.96,
  "text": "Les survivants peuvent enfin retourner à la base, en formation,"
 },
 {
  "start": 2230.28,
  "end": 2233.36,
  "text": "ou parfois seuls, sur le long trajet du retour."
 },
 {
  "start": 2239.26,
  "end": 2242.34,
  "text": "Enfin, c’est la campagne anglaise."
 },
 {
  "start": 2243.54,
  "end": 2244.5,
  "text": "Le Yorkshire."
 },
 {
  "start": 2258.78,
  "end": 2259.54,
  "text": "Voilà le terrain !"
 },
 {
  "start": 2260.1,
  "end": 2260.7,
  "text": "Sauvés !"
 },
 {
  "start": 2262.88,
  "end": 2266.46,
  "text": "La tour et l’officier commandant donnent leurs instructions."
 },
 {
  "start": 2274.4,
  "end": 2276.4,
  "text": "Un dernier virage, et…"
 },
 {
  "start": 2285.24,
  "end": 2288.94,
  "text": "on se pose enfin, en sécurité."
 },
 {
  "start": 2291.84,
  "end": 2295.16,
  "text": "Vient ensuite le debriefing, avec Mrs Plunkett,"
 },
 {
  "start": 2296.44,
  "end": 2298.98,
  "text": "mariée à un Anglais et seule Française de la base."
 },
 {
  "start": 2299.84,
  "end": 2302.72,
  "text": "Elle est à même de comprendre les rapports de raid des équipages français,"
 },
 {
  "start": 2304.0,
  "end": 2306.4,
  "text": "avec leurs avions transformés en passoire."
 }
]
