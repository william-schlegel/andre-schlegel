{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "*.ts", "*.mjs"],
  "exclude": ["dist", ".work", "pipeline"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
